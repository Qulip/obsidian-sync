# Local development database (PostgreSQL with the pgvector extension).
# tests/conftest.py reads this when OBSIDIAN_SYNC_DATABASE_URL is not set,
# then swaps the database name to the dedicated obsidian_sync_test database.
OBSIDIAN_POSTGRESQL_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/obsidian
# Optional FastMCP Host allow-list. Values must exactly match the incoming Host
# header (no wildcard matching). If a proxy forwards www.google.com:443,
# include that exact port-bearing value as a separate entry:
# OBSIDIAN_SYNC_MCP_ALLOWED_HOSTS=["www.google.com","www.google.com:443"]
