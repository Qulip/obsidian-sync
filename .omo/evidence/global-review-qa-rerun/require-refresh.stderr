flag provided but not defined: -require-refresh
Usage of sync:
  --vault-root string
    	local vault directory
  --vault-id string
    	server vault id
  --server string
    	server base url
  --device-id string
    	override the device id
  --verbose
    	enable debug logging
  --dry-run
    	print planned actions without writing or pushing
  --require-obsidian-refresh
    	exit non-zero if the Obsidian refresh step fails
